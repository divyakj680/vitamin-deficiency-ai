# NutriVision AI - Production Deployment Variables
# Copy these values to your deployment platform (e.g., Render, Railway, Vercel)

# ==========================================
# 1. FRONTEND ENVIRONMENT VARIABLES
# ==========================================
# The public URL of the backend API
VITE_API_BASE_URL=https://your-backend-api-url.onrender.com/api
# The public URL of the AI Microservice
VITE_AI_SERVICE_URL=https://your-ai-service-url.onrender.com/api/ai
VITE_APP_ENV=production

# ==========================================
# 2. BACKEND ENVIRONMENT VARIABLES
# ==========================================
SPRING_PROFILES_ACTIVE=prod
# Your Managed MySQL Database URL (e.g., Aiven, Railway, TiDB)
SPRING_DATASOURCE_URL=jdbc:mysql://your-db-host:3306/nutrivision_db?useSSL=true&requireSSL=true
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password
# Generate a random 32+ character string for JWT
APP_JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
# Allowed origins for CORS (Your frontend URL)
APP_CORS_ALLOWED_ORIGINS=https://your-frontend-url.vercel.app,https://your-frontend-url.onrender.com
# URL of the deployed AI service
AI_SERVICE_BASE_URL=https://your-ai-service-url.onrender.com/api/ai

# ==========================================
# 3. AI SERVICE ENVIRONMENT VARIABLES
# ==========================================
HOST=0.0.0.0
PORT=8000
APP_ENV=production
ALLOWED_ORIGINS=https://your-frontend-url.vercel.app,https://your-frontend-url.onrender.com
